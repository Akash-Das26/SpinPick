# ─── Sentry Error Monitoring ────────────────────────────────────────────
# Get your DSN from: Sentry Dashboard → Projects → Your Project → Client Keys (DSN)
# This is a PUBLIC value — safe to include in your frontend build.
VITE_SENTRY_DSN=https://your-dsn-key@your-org.ingest.sentry.io/project-id

# ─── Sentry Source Map Upload (Build-time only) ─────────────────────────
# These are PRIVATE values — never commit them to version control.
# Used by @sentry/vite-plugin during production builds to upload source maps.
# Get these from: Sentry Dashboard → Settings → Developer Settings → Auth Tokens
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# ─── OpenRouter Backend Proxy (RECOMMENDED for production) ──────────────
# Keeps the OpenRouter API key server-side so it never ships in the JS bundle.
# 1. Deploy server/proxy.mjs with the private key in the SERVER environment:
#      OPENROUTER_API_KEY=sk-or-v1-...
# 2. Point the frontend at the deployed proxy (PUBLIC value):
VITE_OPENROUTER_PROXY_URL=https://your-proxy.example.com
#
# Optional attribution headers for the proxy (server-side):
# OPENROUTER_SITE_URL=https://spinpick.app
# OPENROUTER_APP_NAME=SpinPick Decision Studio
#
# Proxy security (server-side):
# Comma-separated allow-list of frontend origins. When set, browser requests
# from other origins get 403. RECOMMENDED for production.
# ALLOWED_ORIGINS=https://spinpick.app,http://localhost:5173
# Optional shared secret for NON-browser clients. When set, requests WITHOUT an
# Origin header (curl, scripts, server-to-server) must send
#   Authorization: Bearer <PROXY_AUTH_TOKEN>
# or they get 401. Closes the credit-burning vector for scripts that discover
# the URL. Browsers are unaffected (gated by ALLOWED_ORIGINS); /health and
# OPTIONS are exempt so healthchecks keep working. RECOMMENDED for production.
# PROXY_AUTH_TOKEN=change-me-to-a-long-random-string
# Upstream request timeout in ms (default 60000).
# UPSTREAM_TIMEOUT_MS=60000
#
# Without a proxy, the app will use the built-in generator only.
# Direct browser OpenRouter calls are disabled for security.

# ─── Gemini AI (Optional — for Smart Weighting) ──────────────────────────
# Get your key from: https://aistudio.google.com/apikey
# When set, Smart Weighting uses Gemini for intelligent analysis.
# When unset, a keyword-based offline engine is used instead.
VITE_GEMINI_API_KEY=
